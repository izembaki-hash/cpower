#include <winver.h>

#ifndef RT_MANIFEST
#define RT_MANIFEST 24
#endif

1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "CPower Project"
            VALUE "FileDescription", "CPower Pure C Windows-Native Computer-Use Agent (uiAccess)"
            VALUE "FileVersion", "1.1.0.0"
            VALUE "InternalName", "cpower_uiaccess.exe"
            VALUE "OriginalFilename", "cpower_uiaccess.exe"
            VALUE "ProductName", "CPower"
            VALUE "ProductVersion", "1.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
